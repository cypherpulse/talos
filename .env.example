# =============================================================================
# Talos — Example environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
#
#   cp .env.example .env
#
# NEVER commit `.env` or real secrets. `.env` is git-ignored.
# The values below are placeholders only — no real keys belong in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# X Layer (chain) — testnet
# -----------------------------------------------------------------------------
XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech
XLAYER_TESTNET_CHAIN_ID=195
XLAYER_EXPLORER_URL=https://www.oklink.com/xlayer-test

# -----------------------------------------------------------------------------
# Deployed protocol contract addresses (populated after deployment)
# -----------------------------------------------------------------------------
TALOS_POOL_ADDRESS=
TALOS_VERIFIER_ADDRESS=

# Test ERC-20 (mock USDC) used on testnet
TEST_USDC_ADDRESS=

# -----------------------------------------------------------------------------
# Agent — signing key for the autonomous agent (testnet only)
# -----------------------------------------------------------------------------
# NEVER use a mainnet or funded key here. Testnet, throwaway keys only.
AGENT_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Relayer — submits transactions on behalf of agents
# -----------------------------------------------------------------------------
RELAYER_PRIVATE_KEY=
RELAYER_RPC_URL=https://testrpc.xlayer.tech

# -----------------------------------------------------------------------------
# LLM provider (agent reasoning) — abstraction, provider-agnostic
# -----------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=

# -----------------------------------------------------------------------------
# Datastores
# -----------------------------------------------------------------------------
# Must match the credentials/ports in docker-compose.yml for local dev.
DATABASE_URL=postgresql://talos:talos@localhost:5432/talos
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Talos Core Server (services/core) — Phase 4
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# X Layer chain (the Core Server reads these; see services/core/src/config).
X_LAYER_RPC_URL=https://testrpc.xlayer.tech
X_LAYER_CHAIN_ID=195
X_LAYER_EXPLORER_URL=https://www.oklink.com/xlayer-test
X_LAYER_CONFIRMATIONS_REQUIRED=2

# Deployed contract addresses used by the server.
# (TALOS_POOL_ADDRESS / TEST_USDC_ADDRESS are defined above.)

# Server signer — testnet/dev key ONLY. Never a funded mainnet key. Never commit.
SIGNER_PRIVATE_KEY=

# 32-byte AES-256-GCM key for note-at-rest encryption (0x + 64 hex). Never commit.
# Generate with: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
NOTE_ENCRYPTION_KEY=

# Directory holding the Phase 3 circuit artifacts (wasm + zkey + vkey).
CIRCUIT_ARTIFACTS_DIR=./circuits/build

# Run BullMQ workers in-process (true) or as a separate worker process (false).
RUN_WORKERS=true

# -----------------------------------------------------------------------------
# Talos Agent + Guard (Phase 5)
# -----------------------------------------------------------------------------
# LLM provider: "rule-based" (deterministic, default) or "anthropic".
LLM_PROVIDER=rule-based
# (LLM_API_KEY / LLM_MODEL are defined above; used when LLM_PROVIDER=anthropic.)

# Agent identity.
AGENT_ID=agent-dev
AGENT_NAME=Talos Dev Agent

# Guard policy (values in the asset's smallest unit; decimal strings).
GUARD_ALLOWED_ASSETS=1
GUARD_MAX_TX_VALUE=1000000000000
GUARD_MAX_DAILY_VALUE=5000000000000
GUARD_REQUIRE_APPROVAL_ABOVE=100000000000
# Comma-separated lowercased addresses allowed as withdrawal recipients.
GUARD_ALLOWED_RECIPIENTS=

# -----------------------------------------------------------------------------
# Frontend (Next.js) — public, browser-exposed values only
# -----------------------------------------------------------------------------
NEXT_PUBLIC_XLAYER_RPC_URL=https://testrpc.xlayer.tech
NEXT_PUBLIC_TALOS_POOL_ADDRESS=
NEXT_PUBLIC_TALOS_VERIFIER_ADDRESS=
NEXT_PUBLIC_TEST_USDC_ADDRESS=
