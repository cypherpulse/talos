# Talos web app (Vite). Copy to `.env` and adjust.
# Only VITE_-prefixed vars are exposed to the browser — never put a private key here.

# Core Server (Talos API) base URL the web app talks to.
VITE_TALOS_API_BASE_URL=http://localhost:3000

# X Layer network the UI links to (testnet = 1952, mainnet = 196).
VITE_CHAIN_ID=1952
VITE_XLAYER_EXPLORER_URL=https://www.oklink.com/xlayer-test
