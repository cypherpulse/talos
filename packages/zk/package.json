{
  "name": "@talos/zk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist *.tsbuildinfo",
    "zk:vectors": "node scripts/gen-vectors.mjs",
    "zk:build": "node scripts/build-circuits.mjs",
    "zk:setup": "node scripts/setup-plonk.mjs",
    "zk:fixtures": "node scripts/gen-fixtures.mjs",
    "zk:negtest": "node scripts/neg-tests.mjs",
    "zk:clienttest": "tsx scripts/client-deposit.test.mts",
    "zk:withdrawtest": "tsx scripts/client-withdraw.test.mts",
    "zk:spendstest": "tsx scripts/client-spends.test.mts",
    "zk:poseidon-check": "node scripts/poseidon-parity.mjs",
    "zk:all": "node scripts/build-circuits.mjs && node scripts/setup-plonk.mjs && node scripts/gen-vectors.mjs && node scripts/gen-fixtures.mjs"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "poseidon-lite": "^0.3.0",
    "tsx": "^4.23.12"
  }
}
