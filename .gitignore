# Dependencies
node_modules/
.pnpm-store/

# Build output
# NOTE: no bare `build/` rule — it would swallow the tracked `circuits/build/`
# scaffold. Circuit build artifacts are ignored by extension below instead.
dist/
out/
.next/
.turbo/
*.tsbuildinfo

# Environment / secrets — NEVER commit real values
.env
.env.*
!.env.example
*.key
*.pem
secrets/
keys.md
*.ps1

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/forge-std/

# ZK artifacts. We DO commit the runtime proving artifacts (prover .wasm, final .zkey,
# and verification keys) so the deployed Core Server can generate proofs. Trusted-setup,
# intermediate, and per-run/secret files are never committed (regenerate with
# `pnpm zk:build && pnpm zk:setup`).
circuits/build/**/*.ptau
circuits/build/ptau/
circuits/build/**/*.r1cs
circuits/build/**/*.sym
circuits/build/**/*.wtns
circuits/build/**/witness.wtns
circuits/build/**/proof.json
circuits/build/**/public.json
# Ignore all zkey files (do not commit final proving keys here).
# If you need final proving keys for runtime, store them in a release asset
# or use Git LFS; do NOT keep large final `.zkey` files in the repo history.
circuits/build/**/*.zkey
# NEVER commit witness input files — they contain private note secrets.
**/*.witness.json
**/inputs/*.json
!circuits/build/**/.gitkeep

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
