{
  "name": "talos",
  "version": "0.1.0",
  "private": true,
  "description": "Talos — The Private Execution Layer for Autonomous AI Agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "zk:build": "pnpm --filter @talos/zk zk:build",
    "zk:setup": "pnpm --filter @talos/zk zk:setup",
    "zk:vectors": "pnpm --filter @talos/zk zk:vectors",
    "zk:fixtures": "pnpm --filter @talos/zk zk:fixtures",
    "zk:negtest": "pnpm --filter @talos/zk zk:negtest",
    "zk:all": "pnpm --filter @talos/zk zk:all"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
